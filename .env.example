APP_NAME=Cpadd Cherry CFO
APP_HOST=0.0.0.0
APP_PORT=8080
DATABASE_PATH=data/cpadd.db

# Qwen OpenAI-compatible endpoint
QWEN_BASE_URL=http://127.0.0.1:8000/v1
QWEN_MODEL=qwen3.5-9b
QWEN_API_KEY=local
QWEN_TEMPERATURE=0.2
QWEN_MAX_TOKENS=1200
QWEN_TIMEOUT_SECONDS=120

# Statement OCR
OCR_LANGUAGES=tha+eng
OCR_DPI=220
OCR_MAX_PAGES=30
OCR_MAX_UPLOAD_MB=20
OCR_USE_QWEN_DEFAULT=true
